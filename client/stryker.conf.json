{
	"$schema": "https://stryker-mutator.io/docs/stryker-js/stryker-config-schema.json",
	"packageManager": "npm",
	"reporters": ["html", "clear-text", "progress"],
	"testRunner": "vitest",
	"vitest": {
		"configFile": "vitest.config.ts"
	},
	"coverageAnalysis": "perTest",
	"mutate": [
		"src/**/*.ts",
		"src/**/*.js",
		"!src/**/*.{test,spec}.{ts,js}",
		"!src/**/*.d.ts",
		"!src/app.html"
	],
	"thresholds": {
		"high": 80,
		"low": 60,
		"break": 50
	},
	"concurrency": 4,
	"timeoutMS": 60000,
	"tempDirName": ".stryker-tmp",
	"cleanTempDir": "always"
}
